# Red Pen configuration. Copy to .env for local development.
# Never commit real secrets. Production values live in the host's secret store.

# --- Database (PostgreSQL 16, UK or EU region in production) ---
# The app connects as redpen_app, which is subject to row-level security.
DATABASE_URL=postgres://redpen_app:redpen_app_dev@localhost:5432/redpen
# Schema owner, used only by migrations and seed scripts.
DATABASE_ADMIN_URL=postgres://redpen_owner:redpen_owner_dev@localhost:5432/redpen

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
# true when running behind a reverse proxy that sets the Host header (most hosts)
AUTH_TRUST_HOST=true
# Public URL of the app in production, e.g. https://app.example.co.uk
# AUTH_URL=
# Sign-in lasts this many hours, then the user must sign in again (max 24).
SESSION_MAX_AGE_HOURS=8

# --- Login rate limiting ---
LOGIN_MAX_FAILURES_PER_EMAIL=5
LOGIN_MAX_FAILURES_PER_IP=30
LOGIN_WINDOW_MINUTES=15

# --- Pupil name encryption ---
# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Losing this key makes stored pupil names unreadable. Pupil codes are unaffected.
PUPIL_NAME_KEY=ZGV2LW9ubHktcHVwaWwtbmFtZS1rZXktMzItYnl0ZXM=

# --- Product ---
# Working name; shown in the header and page titles.
APP_NAME=Red Pen

# --- Container start-up (Dockerfile) ---
# Run pending migrations before the server starts. Needs DATABASE_ADMIN_URL.
RUN_MIGRATIONS_ON_START=false
# Permit the demo seed when NODE_ENV=production (demo deployments only).
ALLOW_DEMO_SEED=false

# --- AI marking ---
# demo: built-in example results, no network (a banner says so). Demo mode is
# also used whenever ANTHROPIC_API_KEY is empty.
MARKING_MODE=demo
ANTHROPIC_API_KEY=
# Required when not in demo mode. Never hard-coded in the app.
ANTHROPIC_MODEL=claude-opus-5-5
# Thinking effort: low | medium | high | xhigh | max, or "default" for the model's own default.
MARKING_EFFORT=high
# "default" re-runs a request the model declines for policy reasons on Anthropic's
# recommended fallback model, server side. "off" if your model does not support it.
ANTHROPIC_FALLBACKS=default
# Optional: inference region passed as inference_geo. Check which values your
# account supports before relying on it (see docs/claims.md, build step 6).
# ANTHROPIC_INFERENCE_GEO=
# Scripts marked at once by the in-process worker.
MARKING_CONCURRENCY=4
# Set to "off" to run the worker in a separate process instead of in the web server.
MARKING_WORKER=on
# Hourly limits on scripts sent for AI marking.
MARKING_LIMIT_PER_TEACHER_PER_HOUR=300
MARKING_LIMIT_PER_SCHOOL_PER_HOUR=1500

# --- Evaluation harness (npm run eval) cost reporting, USD per million tokens ---
# Values for the model above; check current pricing before relying on them.
MODEL_PRICE_INPUT_PER_MTOK=4
MODEL_PRICE_CACHE_READ_PER_MTOK=0.2
MODEL_PRICE_OUTPUT_PER_MTOK=20
EVAL_MAX_DROP=0.05
