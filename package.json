{
  "name": "redpen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed-dev.ts",
    "db:reset": "tsx --env-file-if-exists=.env scripts/reset-dev.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:demo": "playwright test -c playwright.demo.config.ts",
    "eval": "tsx --env-file-if-exists=.env scripts/eval.ts",
    "worker": "tsx --env-file-if-exists=.env scripts/worker.ts",
    "docs:claims": "tsx scripts/claims-doc.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@aws-sdk/client-s3": "3.1146.0",
    "@node-rs/argon2": "2.2.2",
    "drizzle-orm": "0.45.3",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.32",
    "pg-boss": "12.36.0",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.1.14",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
